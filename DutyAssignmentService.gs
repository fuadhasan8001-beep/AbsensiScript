const DutyService={list(c){return DB.rows('DUTY_ASSIGNMENTS').filter(d=>c.role==='SUPER_ADMIN'||String(d.employeeId)===String(c.employeeId)||(c.role==='ADMIN_DESA'&&String(DB.by('EMPLOYEES','employeeId',d.employeeId)?.primaryOfficeId)===String(c.villageId))||(c.role==='ADMIN_KECAMATAN'&&String(DB.by('EMPLOYEES','employeeId',d.employeeId)?.districtId)===String(c.districtId)));},request(c,p){const e=DB.by('EMPLOYEES','employeeId',p.employeeId||c.employeeId);if(!e)throw new Error('Pegawai tidak ditemukan.');Access.employee(c,e.employeeId);const office=DB.by('OFFICES','officeId',p.officeId);if(!office||!p.startAt||!p.endAt||new Date(p.startAt)>=new Date(p.endAt))throw new Error('Data penugasan tidak valid.');const id=Utils.id('duty');DB.append('DUTY_ASSIGNMENTS',{dutyId:id,employeeId:e.employeeId,officeId:office.officeId,startAt:p.startAt,endAt:p.endAt,reason:Utils.clean(p.reason),requestedBy:c.id,status:'PENDING',approvedBy:'',decidedAt:'',createdAt:Utils.iso(Utils.now())});AuditService.log(c,'DUTY_REQUEST','DUTY_ASSIGNMENTS',id,{});return {dutyId:id,status:'PENDING'};},decide(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN']);const d=DB.by('DUTY_ASSIGNMENTS','dutyId',p.dutyId),o=d&&DB.by('OFFICES','officeId',d.officeId);if(!d||!Access.officeScope(c,o)||!['APPROVED','REJECTED'].includes(p.decision))throw new Error('Keputusan penugasan tidak valid atau di luar kewenangan.');DB.update('DUTY_ASSIGNMENTS','dutyId',d.dutyId,{status:p.decision,approvedBy:c.id,decidedAt:Utils.iso(Utils.now())});DB.append('DUTY_ASSIGNMENT_APPROVALS',{approvalId:Utils.id('ap'),dutyId:d.dutyId,actorId:c.id,decision:p.decision,note:Utils.clean(p.note),createdAt:Utils.iso(Utils.now())});AuditService.log(c,'DUTY_'+p.decision,'DUTY_ASSIGNMENTS',d.dutyId,{});return {dutyId:d.dutyId,status:p.decision};}};
