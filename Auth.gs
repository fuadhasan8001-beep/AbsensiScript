const Auth={verify_(token){if(!token)throw new Error('Silakan masuk menggunakan Google terlebih dahulu.');const key=prop_('FIREBASE_WEB_API_KEY');const response=UrlFetchApp.fetch('https://identitytoolkit.googleapis.com/v1/accounts:lookup?key='+encodeURIComponent(key),{method:'post',contentType:'application/json',payload:JSON.stringify({idToken:token}),muteHttpExceptions:true});const code=response.getResponseCode();if(code!==200)throw new Error('Sesi login tidak valid atau telah kedaluwarsa. Silakan masuk kembali.');const user=JSON.parse(response.getContentText()).users?.[0];if(!user||!user.emailVerified)throw new Error('Akun Google harus memiliki email terverifikasi.');return user;},require_(token){const f=this.verify_(token),email=Utils.email(f.email),u=DB.rows('USERS').find(x=>Utils.email(x.email)===email);if(!u||String(u.status).toUpperCase()!=='ACTIVE')throw new Error('Akun Anda belum terdaftar atau dinonaktifkan. Hubungi administrator.');return {id:u.userId,email,role:u.role,employeeId:u.employeeId,districtId:u.districtId,villageId:u.villageId};}};
