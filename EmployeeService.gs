const EmployeeService={list(c){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN','ADMIN_DESA']);return DB.rows('EMPLOYEES').filter(e=>{const o=DB.by('OFFICES','officeId',e.primaryOfficeId);return o&&Access.officeScope(c,o);});},save(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN','ADMIN_DESA']);const d=p.employee||{};if(!d.name||!d.email||!d.primaryOfficeId)throw new Error('Nama, email, dan kantor utama wajib diisi.');const office=DB.by('OFFICES','officeId',d.primaryOfficeId);if(!office||!Access.officeScope(c,office))throw new Error('Kantor di luar kewenangan.');const id=d.employeeId||Utils.id('emp'),obj={employeeId:id,identityNo:Utils.clean(d.identityNo),name:Utils.clean(d.name,150),email:Utils.email(d.email),phone:Utils.clean(d.phone,40),position:Utils.clean(d.position),unit:Utils.clean(d.unit),primaryOfficeId:d.primaryOfficeId,status:d.status||'ACTIVE',startDate:d.startDate||Utils.dateKey(Utils.now()),createdAt:d.createdAt||Utils.iso(Utils.now())};if(d.employeeId)DB.update('EMPLOYEES','employeeId',id,obj);else DB.append('EMPLOYEES',obj);AuditService.log(c,'EMPLOYEE_SAVE','EMPLOYEES',id,{});return obj;}};
