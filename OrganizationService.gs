const OrganizationService={list(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN','ADMIN_DESA']);const districts=DB.rows('KECAMATAN').filter(d=>c.role==='SUPER_ADMIN'||String(d.districtId)===String(c.districtId));const villages=DB.rows('DESA').filter(v=>c.role==='SUPER_ADMIN'||String(v.districtId)===String(c.districtId));return {districts,villages};},save(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN']);const kind=p.kind, d=p.record||{};if(kind==='district'){Access.requireRole(c,['SUPER_ADMIN']);const id=d.districtId||Utils.id('dist'),x={districtId:id,name:Utils.clean(d.name,120),code:Utils.clean(d.code,30),status:d.status||'ACTIVE'};if(!x.name)throw new Error('Nama kecamatan wajib diisi.');d.districtId?DB.update('KECAMATAN','districtId',id,x):DB.append('KECAMATAN',x);AuditService.log(c,'DISTRICT_SAVE','KECAMATAN',id,{});return x;}if(kind==='village'){const districtId=d.districtId||c.districtId;if(c.role!=='SUPER_ADMIN'&&String(districtId)!==String(c.districtId))throw new Error('Kecamatan di luar kewenangan.');const id=d.villageId||Utils.id('vil'),x={villageId:id,districtId,name:Utils.clean(d.name,120),code:Utils.clean(d.code,30),status:d.status||'ACTIVE'};if(!x.name)throw new Error('Nama desa wajib diisi.');d.villageId?DB.update('DESA','villageId',id,x):DB.append('DESA',x);AuditService.log(c,'VILLAGE_SAVE','DESA',id,{});return x;}throw new Error('Jenis data organisasi tidak dikenal.');}};
