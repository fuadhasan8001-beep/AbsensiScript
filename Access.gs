const Access={requireRole(c,roles){if(!roles.includes(c.role))throw new Error('Anda tidak memiliki akses untuk tindakan ini.');},employee(c,id){if(c.role==='SUPER_ADMIN')return;if(c.role==='ADMIN_KECAMATAN'||c.role==='ADMIN_DESA'){const e=DB.by('EMPLOYEES','employeeId',id),o=e&&DB.by('OFFICES','officeId',e.primaryOfficeId);if(o&&this.officeScope(c,o))return;throw new Error('Data pegawai di luar kewenangan wilayah Anda.');}if(String(c.employeeId)!==String(id))throw new Error('Akses hanya tersedia untuk data Anda sendiri.');},officeScope(c,office){if(c.role==='SUPER_ADMIN')return true;if(c.role==='ADMIN_KECAMATAN')return String(office.districtId)===String(c.districtId);if(c.role==='ADMIN_DESA')return String(office.villageId)===String(c.villageId);return false;}};
