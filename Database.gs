const DB={ss(){const id=PropertiesService.getScriptProperties().getProperty('DATABASE_SPREADSHEET_ID')||DEFAULT_DATABASE_SPREADSHEET_ID;return SpreadsheetApp.openById(id);}, sheet(name){if(!TABLES[name])throw new Error('Tabel database tidak dikenal: '+name);const ss=this.ss();let s=ss.getSheetByName(name);if(!s){try{s=ss.insertSheet(name);}catch(error){s=ss.getSheetByName(name);if(!s)throw error;}}if(s.getLastRow()===0){try{s.getRange(1,1,1,TABLES[name].length).setValues([TABLES[name]]);}catch(error){if(s.getLastRow()===0)throw error;}}return s;}, init(){const ss=this.ss();Object.keys(TABLES).forEach(n=>{let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);if(s.getLastRow()===0)s.getRange(1,1,1,TABLES[n].length).setValues([TABLES[n]]);});return 'Database siap';}, rows(name){const s=this.sheet(name),n=s.getLastRow();if(n<2)return [];const vals=s.getRange(1,1,n,TABLES[name].length).getValues(),heads=vals.shift();return vals.filter(r=>r.some(x=>x!=='')).map(r=>Object.fromEntries(heads.map((h,i)=>[h,r[i]])));}, by(name,key,value){return this.rows(name).find(r=>String(r[key])===String(value))||null;}, append(name,obj){this.appendMany(name,[obj]);}, appendMany(name,objects){if(!objects||!objects.length)return;const heads=TABLES[name],sheet=this.sheet(name),start=sheet.getLastRow()+1,rows=objects.map(obj=>heads.map(k=>obj[k]===undefined?'':obj[k]));for(let i=0;i<rows.length;i+=200){const part=rows.slice(i,i+200);sheet.getRange(start+i,1,part.length,heads.length).setValues(part);}}, update(name,key,value,patch){const s=this.sheet(name),heads=TABLES[name],ix=heads.indexOf(key);if(ix<0)throw new Error('Kolom tidak ditemukan');const found=s.getRange(2,ix+1,Math.max(s.getLastRow()-1,1),1).createTextFinder(String(value)).matchEntireCell(true).findNext();if(!found)throw new Error('Data tidak ditemukan');const row=found.getRow(),old=Object.fromEntries(heads.map((h,i)=>[h,s.getRange(row,i+1).getValue()]));const next={...old,...patch};s.getRange(row,1,1,heads.length).setValues([heads.map(h=>next[h]??'')]);return next;}};
