const ReportService={get(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN','ADMIN_DESA']);const from=p.from||Utils.dateKey(Utils.now()),to=p.to||from;if(from>to)throw new Error('Rentang tanggal tidak valid.');let employees=EmployeeService.list(c);if(p.employeeId){Access.employee(c,p.employeeId);employees=employees.filter(e=>String(e.employeeId)===String(p.employeeId));}if(p.officeId){if(!OfficeService.list(c).some(o=>String(o.officeId)===String(p.officeId)))throw new Error('Kantor di luar cakupan akses.');employees=employees.filter(e=>String(e.primaryOfficeId)===String(p.officeId));}const scopeOffices=OfficeService.list(c);if(p.districtId){if(!scopeOffices.some(o=>String(o.districtId)===String(p.districtId)))throw new Error('Kecamatan di luar cakupan akses.');employees=employees.filter(e=>String(DB.by('OFFICES','officeId',e.primaryOfficeId)?.districtId)===String(p.districtId));}if(p.villageId){if(!scopeOffices.some(o=>String(o.villageId)===String(p.villageId)))throw new Error('Desa di luar cakupan akses.');employees=employees.filter(e=>String(DB.by('OFFICES','officeId',e.primaryOfficeId)?.villageId)===String(p.villageId));}const ids=new Set(employees.map(e=>String(e.employeeId)));const rows=DB.rows('ATTENDANCES').filter(a=>ids.has(String(a.employeeId))&&a.date>=from&&a.date<=to&&(!p.officeId||String(a.officeId)===String(p.officeId)));return {rows,summary:{total:rows.length,late:rows.filter(a=>Number(a.lateMinutes)>0).length,checkedOut:rows.filter(a=>a.checkOutAt).length}};},dashboard(c){if(c.role==='PEGAWAI'){const a=AttendanceService.today(c);return {cards:[{label:'Status hari ini',value:a?(a.checkOutAt?'Selesai':'Hadir'):'Belum hadir'},{label:'Check-in',value:a?.checkInAt||'—'},{label:'Check-out',value:a?.checkOutAt||'—'}],rows:AttendanceService.history(c,{})};}const employees=EmployeeService.list(c),ids=new Set(employees.map(e=>String(e.employeeId))),today=Utils.dateKey(Utils.now()),att=DB.rows('ATTENDANCES').filter(a=>a.date===today&&ids.has(String(a.employeeId)));return {cards:[{label:'Jumlah pegawai',value:employees.length},{label:'Hadir hari ini',value:att.length},{label:'Terlambat',value:att.filter(a=>Number(a.lateMinutes)>0).length},{label:'Belum hadir',value:Math.max(0,employees.length-att.length)}],rows:att};}};
