const ReportService={get(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN','ADMIN_DESA']);const from=p.from||Utils.dateKey(Utils.now()),to=p.to||from;if(from>to)throw new Error('Rentang tanggal tidak valid.');const employees=EmployeeService.list(c),ids=new Set(employees.map(e=>String(e.employeeId)));const rows=DB.rows('ATTENDANCES').filter(a=>ids.has(String(a.employeeId))&&a.date>=from&&a.date<=to);return {rows,summary:{total:rows.length,late:rows.filter(a=>Number(a.lateMinutes)>0).length,checkedOut:rows.filter(a=>a.checkOutAt).length}};},dashboard(c){if(c.role==='PEGAWAI'){const a=AttendanceService.today(c);return {cards:[{label:'Status hari ini',value:a?(a.checkOutAt?'Selesai':'Hadir'):'Belum hadir'},{label:'Check-in',value:a?.checkInAt||'—'},{label:'Check-out',value:a?.checkOutAt||'—'}],rows:AttendanceService.history(c,{})};}const employees=EmployeeService.list(c),ids=new Set(employees.map(e=>String(e.employeeId))),today=Utils.dateKey(Utils.now()),att=DB.rows('ATTENDANCES').filter(a=>a.date===today&&ids.has(String(a.employeeId)));return {cards:[{label:'Jumlah pegawai',value:employees.length},{label:'Hadir hari ini',value:att.length},{label:'Terlambat',value:att.filter(a=>Number(a.lateMinutes)>0).length},{label:'Belum hadir',value:Math.max(0,employees.length-att.length)}],rows:att};}};
