const ReportService={get(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN','ADMIN_DESA']);const from=p.from||Utils.dateKey(new Date()),to=p.to||from;const employees=EmployeeService.list(c),ids=new Set(employees.map(e=>String(e.employeeId)));const rows=DB.rows('ATTENDANCES').filter(a=>ids.has(String(a.employeeId))&&a.date>=from&&a.date<=to);return {rows,summary:{total:rows.length,late:rows.filter(a=>Number(a.lateMinutes)>0).length,checkedOut:rows.filter(a=>a.checkOutAt).length}};}};
