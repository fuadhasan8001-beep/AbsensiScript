const ScheduleService={list(c){return DB.rows('WORK_SCHEDULES').filter(s=>{const o=DB.by('OFFICES','officeId',s.officeId);return o&&Access.officeScope(c,o);});},forOffice(id){const cache=CacheService.getScriptCache(),key='schedule:'+id,hit=cache.get(key);if(hit)return JSON.parse(hit);const s=this.list({role:'SUPER_ADMIN'}).find(x=>String(x.officeId)===String(id)&&String(x.status).toUpperCase()==='ACTIVE');if(s)cache.put(key,JSON.stringify(s),APP.CACHE_SECONDS);return s;},save(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN']);const d=p.schedule||{};const id=d.scheduleId||Utils.id('sch');const o=DB.by('OFFICES','officeId',d.officeId);if(!o||!Access.officeScope(c,o))throw new Error('Kantor di luar kewenangan.');const s={scheduleId:id,officeId:d.officeId,days:d.days||'1,2,3,4,5',checkInStart:d.checkInStart||'06:00',checkInEnd:d.checkInEnd||'09:00',checkOutStart:d.checkOutStart||'15:00',checkOutEnd:d.checkOutEnd||'23:00',workStart:d.workStart||'08:00',workEnd:d.workEnd||'16:00',lateToleranceM:Number(d.lateToleranceM)||0,status:d.status||'ACTIVE'};if(d.scheduleId)DB.update('WORK_SCHEDULES','scheduleId',id,s);else DB.append('WORK_SCHEDULES',s);CacheService.getScriptCache().remove('schedule:'+s.officeId);AuditService.log(c,'SCHEDULE_SAVE','WORK_SCHEDULES',id,{});return s;}};
