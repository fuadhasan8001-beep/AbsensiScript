const OfficeService={list(c){return DB.rows('OFFICES').filter(o=>c.role==='SUPER_ADMIN'||Access.officeScope(c,o));},save(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN']);const d=p.office||{};if(!d.name)throw new Error('Nama kantor wajib diisi.');const id=d.officeId||Utils.id('off'),o={officeId:id,name:Utils.clean(d.name,150),type:d.type||'DESA',districtId:d.districtId||c.districtId,villageId:d.villageId||'',address:Utils.clean(d.address),latitude:Utils.number(d.latitude,'Latitude'),longitude:Utils.number(d.longitude,'Longitude'),radiusM:Utils.number(d.radiusM,'Radius'),status:d.status||'ACTIVE'};if(Math.abs(o.latitude)>90||Math.abs(o.longitude)>180||o.radiusM<1)throw new Error('Koordinat atau radius kantor tidak valid.');if(d.officeId)DB.update('OFFICES','officeId',id,o);else DB.append('OFFICES',o);AuditService.log(c,'OFFICE_SAVE','OFFICES',id,{});return o;}};
