const OfficeService={list(c){const all=DB.rows('OFFICES');if(c.role==='SUPER_ADMIN')return all;if(c.role==='ADMIN_KECAMATAN'||c.role==='ADMIN_DESA')return all.filter(o=>Access.officeScope(c,o));const ids=new Set();if(c.employeeId){const e=DB.by('EMPLOYEES','employeeId',c.employeeId);if(e)ids.add(String(e.primaryOfficeId));}const now=Utils.now();DB.rows('DUTY_ASSIGNMENTS').filter(d=>String(d.employeeId)===String(c.employeeId)&&d.status==='APPROVED'&&new Date(d.startAt)<=now&&new Date(d.endAt)>=now).forEach(d=>ids.add(String(d.officeId)));return all.filter(o=>ids.has(String(o.officeId))&&String(o.status).toUpperCase()==='ACTIVE');},save(c,p){Access.requireRole(c,['SUPER_ADMIN','ADMIN_KECAMATAN']);const d=p.office||{};let prior=null;if(d.officeId){prior=DB.by('OFFICES','officeId',d.officeId);if(!prior||!Access.officeScope(c,prior))throw new Error('Kantor di luar kewenangan.');}if(!d.name)throw new Error('Nama kantor wajib diisi.');const districtId=d.districtId||c.districtId,villageId=d.villageId||'';if(c.role==='ADMIN_KECAMATAN'&&String(districtId)!==String(c.districtId))throw new Error('Kecamatan di luar kewenangan.');if(villageId){const village=DB.by('DESA','villageId',villageId);if(!village||String(village.districtId)!==String(districtId))throw new Error('Desa tidak sesuai dengan kecamatan.');}const id=d.officeId||Utils.id('off'),o={officeId:id,name:Utils.clean(d.name,150),type:d.type||'DESA',districtId,villageId,address:Utils.clean(d.address),latitude:prior?.latitude||'',longitude:prior?.longitude||'',radiusM:15,status:d.status||'ACTIVE'};if(d.officeId)DB.update('OFFICES','officeId',id,o);else DB.append('OFFICES',o);AuditService.log(c,'OFFICE_SAVE','OFFICES',id,{});return o;}};
