function doGet(){const t=HtmlService.createTemplateFromFile('Index');t.firebaseConfig={apiKey:prop_('FIREBASE_WEB_API_KEY',false)||'',authDomain:prop_('FIREBASE_AUTH_DOMAIN',false)||'',projectId:prop_('FIREBASE_PROJECT_ID',false)||''};return t.evaluate().setTitle(APP.NAME).addMetaTag('viewport','width=device-width, initial-scale=1');}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function api(action, payload){try{payload=payload||{};const ctx=Auth.require_(payload.token);return {ok:true,data:Router.dispatch_(action,payload,ctx)};}catch(e){return {ok:false,error:Errors.public_(e)};}}
function initializeDatabase(){return DB.init();}
const Router={dispatch_(a,p,c){const routes={bootstrap:()=>UserService.bootstrap(c),dashboard:()=>ReportService.dashboard(c),attendanceToday:()=>AttendanceService.today(c),attendanceHistory:()=>AttendanceService.history(c,p),checkIn:()=>AttendanceService.punch(c,p,'in'),checkOut:()=>AttendanceService.punch(c,p,'out'),dutyList:()=>DutyService.list(c),dutyRequest:()=>DutyService.request(c,p),dutyDecision:()=>DutyService.decide(c,p),employeeList:()=>EmployeeService.list(c,p),employeeSave:()=>EmployeeService.save(c,p),officeList:()=>OfficeService.list(c),officeSave:()=>OfficeService.save(c,p),scheduleList:()=>ScheduleService.list(c),scheduleSave:()=>ScheduleService.save(c,p),report:()=>ReportService.get(c,p),auditList:()=>AuditService.list(c,p),correctionRequest:()=>AttendanceService.correction(c,p),correctionList:()=>AttendanceService.correctionList(c),correctionDecision:()=>AttendanceService.correctionDecision(c,p),orgList:()=>OrganizationService.list(c,p),orgSave:()=>OrganizationService.save(c,p),holidayList:()=>ScheduleService.holidays(c),holidaySave:()=>ScheduleService.saveHoliday(c,p),profile:()=>UserService.profile(c),settings:()=>UserService.settings(c)};if(!routes[a])throw new Error('Aksi tidak dikenal');return routes[a]();}};
