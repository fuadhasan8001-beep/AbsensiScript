const UserService={bootstrap(c){const user=DB.by('USERS','userId',c.id);const employee=c.employeeId?DB.by('EMPLOYEES','employeeId',c.employeeId):null;return {user,employee,app:{name:APP.NAME,version:APP.VERSION},today:Utils.dateKey(Utils.now())};},profile(c){return this.bootstrap(c);},settings(c){Access.requireRole(c,['SUPER_ADMIN']);return {app:{name:APP.NAME,version:APP.VERSION,timezone:APP.TZ,maxGpsAccuracy:APP.MAX_GPS_ACCURACY_M},counts:Object.fromEntries(Object.keys(TABLES).map(n=>[n,DB.sheet(n).getLastRow()-1]))};}};
