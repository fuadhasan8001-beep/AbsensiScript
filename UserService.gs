const UserService={bootstrap(c){const user=DB.by('USERS','userId',c.id);const employee=(c.employeeId&&DB.by('EMPLOYEES','employeeId',c.employeeId))||DB.rows('EMPLOYEES').find(e=>Utils.email(e.email)===Utils.email(c.email))||null;return {user,employee,app:{name:APP.NAME,version:APP.VERSION},today:Utils.dateKey(Utils.now())};},profile(c){return this.bootstrap(c);},settings(c){Access.requireRole(c,['SUPER_ADMIN']);return {app:{name:APP.NAME,version:APP.VERSION,timezone:APP.TZ,maxGpsAccuracy:APP.MAX_GPS_ACCURACY_M},counts:Object.fromEntries(Object.keys(TABLES).map(n=>[n,DB.sheet(n).getLastRow()-1]))};},userList(c){Access.requireRole(c,['SUPER_ADMIN']);return DB.rows('USERS');},userSave(c,p){Access.requireRole(c,['SUPER_ADMIN']);const d=p.user||{},email=Utils.email(d.email),roles=['PEGAWAI','ADMIN_DESA','ADMIN_KECAMATAN'];if(!email||!email.includes('@')||!roles.includes(d.role))throw new Error('Email atau role akun tidak valid. Super Admin diberikan melalui proses bootstrap pemilik.');if(d.role==='ADMIN_KECAMATAN'&&!d.districtId)throw new Error('Admin kecamatan harus memiliki wilayah kecamatan.');if(d.role==='ADMIN_DESA'&&!d.villageId)throw new Error('Admin desa harus memiliki wilayah desa.');const existing=DB.rows('USERS').find(u=>Utils.email(u.email)===email),status=d.status||existing?.status||'ACTIVE';let employee=null;if(d.employeeId)employee=DB.by('EMPLOYEES','employeeId',d.employeeId);else{const matches=DB.rows('EMPLOYEES').filter(e=>Utils.email(e.email)===email);if(matches.length>1)throw new Error('Email ini cocok dengan lebih dari satu profil pegawai. Pilih profil pegawai secara manual.');employee=matches[0]||null;}if(d.employeeId&&!employee)throw new Error('Data pegawai terkait tidak ditemukan.');if(employee&&Utils.email(employee.email)!==email)throw new Error('Email akun harus sama dengan email pada profil pegawai yang ditautkan.');if(status==='ACTIVE'&&!employee)throw new Error('Profil pegawai untuk email ini belum ditemukan. Buat data pegawai dengan email yang sama, lalu tautkan profil tersebut sebelum mengaktifkan akun.');if(d.districtId&&!DB.by('KECAMATAN','districtId',d.districtId))throw new Error('Kecamatan tidak ditemukan.');if(d.villageId){const village=DB.by('DESA','villageId',d.villageId);if(!village||d.districtId&&String(village.districtId)!==String(d.districtId))throw new Error('Desa tidak ditemukan atau tidak sesuai kecamatan.');}const office=employee&&DB.by('OFFICES','officeId',employee.primaryOfficeId);if(status==='ACTIVE'&&(!office||String(office.status).toUpperCase()!=='ACTIVE'||String(employee.status).toUpperCase()!=='ACTIVE'))throw new Error('Profil pegawai atau kantor penempatannya belum aktif. Aktifkan keduanya sebelum mengaktifkan akun.');if(status==='ACTIVE'&&d.role==='ADMIN_KECAMATAN'&&String(office.districtId)!==String(d.districtId))throw new Error('Kantor profil admin tidak sesuai dengan kecamatan yang dipilih.');if(status==='ACTIVE'&&d.role==='ADMIN_DESA'&&String(office.villageId)!==String(d.villageId))throw new Error('Kantor profil admin tidak sesuai dengan desa yang dipilih.');const id=existing?.userId||Utils.id('usr'),user={userId:id,email,role:d.role,status,employeeId:employee?.employeeId||'',districtId:d.districtId||'',villageId:d.villageId||'',createdAt:existing?.createdAt||Utils.iso(Utils.now()),updatedAt:Utils.iso(Utils.now())};if(existing)DB.update('USERS','userId',id,user);else DB.append('USERS',user);AuditService.log(c,'USER_ROLE_SAVE','USERS',id,{role:user.role,status:user.status});return user;}};
