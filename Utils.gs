const Utils={id(prefix){return prefix+'_'+Utilities.getUuid().replace(/-/g,'');},now(){return new Date();},dateKey(d){return Utilities.formatDate(d,APP.TZ,'yyyy-MM-dd');},iso(d){return Utilities.formatDate(d,APP.TZ,"yyyy-MM-dd'T'HH:mm:ssXXX");},email(s){return String(s||'').trim().toLowerCase();},json(o){return JSON.stringify(o||{});},number(v,n){const x=Number(v);if(!Number.isFinite(x))throw new Error(n+' tidak valid');return x;},clean(s,max=500){return String(s||'').trim().slice(0,max);}};
const Errors={public_(e){const m=String(e&&e.message||'Terjadi kesalahan');return m.startsWith('HTTP')||m.includes('Exception')?'Permintaan tidak dapat diproses. Silakan coba kembali.':m;}};
