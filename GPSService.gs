const GPSService={distance(a,b,c,d){const R=6371000,rad=x=>x*Math.PI/180,dl=rad(c-a),dn=rad(d-b),q=Math.sin(dl/2)**2+Math.cos(rad(a))*Math.cos(rad(c))*Math.sin(dn/2)**2;return 2*R*Math.atan2(Math.sqrt(q),Math.sqrt(1-q));},validate(p,location,office){const lat=Utils.number(p.latitude,'Latitude'),lng=Utils.number(p.longitude,'Longitude'),acc=Utils.number(p.accuracy,'Akurasi GPS');if(Math.abs(lat)>90||Math.abs(lng)>180||acc<0)throw new Error('Koordinat GPS tidak valid.');if(acc>APP.MAX_GPS_ACCURACY_M)throw new Error('Akurasi GPS terlalu rendah. Coba lagi di area terbuka.');if(office&&String(office.status).toUpperCase()!=='ACTIVE')throw new Error('Lokasi kantor tidak aktif.');if(!location||!Number.isFinite(Number(location.latitude))||!Number.isFinite(Number(location.longitude)))throw new Error('Koordinat absensi wilayah belum tersedia.');const distance=this.distance(lat,lng,Number(location.latitude),Number(location.longitude)),radius=15;if(distance>radius)throw new Error('Anda berada di luar radius absensi 15 meter ('+Math.round(distance)+' m).');return {lat,lng,acc,distance:Math.round(distance)};}};
