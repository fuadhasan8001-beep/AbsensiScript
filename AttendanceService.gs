const AttendanceService={today(c){const e=this.myEmployee(c),date=Utils.dateKey(Utils.now());return DB.rows('ATTENDANCES').find(a=>String(a.employeeId)===String(e.employeeId)&&a.date===date)||null;},myEmployee(c){const e=DB.by('EMPLOYEES','employeeId',c.employeeId);if(!e||String(e.status).toUpperCase()!=='ACTIVE')throw new Error('Data pegawai aktif tidak ditemukan.');return e;},history(c,p){const id=p.employeeId||c.employeeId;Access.employee(c,id);return DB.rows('ATTENDANCES').filter(a=>String(a.employeeId)===String(id)).slice(-120).reverse();},punch(c,p,kind){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const e=this.myEmployee(c),now=Utils.now(),date=Utils.dateKey(now);let a=DB.rows('ATTENDANCES').find(x=>String(x.employeeId)===String(e.employeeId)&&x.date===date);if(kind==='in'&&a)throw new Error('Anda sudah melakukan check-in hari ini.');if(kind==='out'&&(!a||!a.checkInAt))throw new Error('Anda belum melakukan check-in.');if(kind==='out'&&a.checkOutAt)throw new Error('Anda sudah melakukan check-out hari ini.');const office=OfficeService.list(c).find(o=>String(o.officeId)===String(e.primaryOfficeId));let duty=null;if(!office)throw new Error('Lokasi kantor utama tidak tersedia.');let allowed=office;if(p.officeId&&String(p.officeId)!==String(office.officeId)){duty=DB.rows('DUTY_ASSIGNMENTS').find(x=>String(x.employeeId)===String(e.employeeId)&&String(x.officeId)===String(p.officeId)&&x.status==='APPROVED'&&new Date(x.startAt)<=now&&new Date(x.endAt)>=now);if(!duty)throw new Error('Anda belum memiliki penugasan yang disetujui untuk kantor ini.');allowed=OfficeService.list(c).find(o=>String(o.officeId)===String(p.officeId));}const g=GPSService.validate(p,allowed);const schedule=ScheduleService.forOffice(allowed.officeId);if(schedule){const hm=Utilities.formatDate(now,APP.TZ,'HH:mm'),day=Number(Utilities.formatDate(now,APP.TZ,'u'));if(!String(schedule.days).split(',').includes(String(day)))throw new Error('Hari ini bukan hari kerja sesuai jadwal.');const start=kind==='in'?schedule.checkInStart:schedule.checkOutStart,end=kind==='in'?schedule.checkInEnd:schedule.checkOutEnd;if(hm<start||hm>end)throw new Error('Waktu '+(kind==='in'?'check-in':'check-out')+' di luar jadwal.');}if(kind==='in'){const workStart=schedule?.workStart||'08:00', [h,m]=workStart.split(':').map(Number),base=new Date(now);base.setHours(h,m,0,0);const late=Math.max(0,Math.floor((now-base)/60000)-(Number(schedule?.lateToleranceM)||0));a={attendanceId:Utils.id('att'),employeeId:e.employeeId,date,officeId:allowed.officeId,dutyId:duty?.dutyId||'',checkInAt:Utils.iso(now),checkInLat:g.lat,checkInLng:g.lng,checkInAccuracy:g.acc,checkInDistanceM:g.distance,checkOutAt:'',checkOutLat:'',checkOutLng:'',checkOutAccuracy:'',checkOutDistanceM:'',lateMinutes:late,createdAt:Utils.iso(now)};DB.append('ATTENDANCES',a);}else{a=DB.update('ATTENDANCES','attendanceId',a.attendanceId,{checkOutAt:Utils.iso(now),checkOutLat:g.lat,checkOutLng:g.lng,checkOutAccuracy:g.acc,checkOutDistanceM:g.distance});}AuditService.log(c,kind==='in'?'CHECK_IN':'CHECK_OUT','ATTENDANCES',a.attendanceId,{officeId:allowed.officeId,distanceM:g.distance});return a;}finally{lock.releaseLock();}},correction(c,p){const id=Utils.id('adj'),att=DB.by('ATTENDANCES','attendanceId',p.attendanceId);if(!att)throw new Error('Absensi tidak ditemukan.');Access.employee(c,att.employeeId);DB.append('ATTENDANCE_ADJUSTMENTS',{adjustmentId:id,attendanceId:att.attendanceId,employeeId:att.employeeId,date:att.date,beforeJson:Utils.json(att),proposedJson:Utils.json(p.proposed||{}),reason:Utils.clean(p.reason),requestedBy:c.id,status:'PENDING',decidedBy:'',decidedAt:'',createdAt:Utils.iso(Utils.now())});AuditService.log(c,'CORRECTION_REQUEST','ATTENDANCE_ADJUSTMENTS',id,{});return {adjustmentId:id,status:'PENDING'};}};
